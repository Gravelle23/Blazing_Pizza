
@page "/checkout"
@using BlazingPizza.Services
@inject OrderState OrderState

@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager


<div class="main">
    <div class="checkout-cols">
        <div class="checkout-order-details">
            <h2>Review Your Order</h2>

            @if (OrderState.Order.Pizzas.Any())
            {
                @foreach (var pizza in OrderState.Order.Pizzas)
                {
                    <p>
                        <strong>
                            @pizza.Size" @pizza.Special.Name
                            ($@pizza.GetFormattedTotalPrice())
                        </strong>
                    </p>
                }

                <hr />

                <h3>
                    Total: $@OrderState.Order.GetFormattedTotalPrice()
                </h3>

                <button class="checkout-button btn btn-warning"
                        @onclick="PlaceOrder"
                        disabled="@isSubmitting">
                    Place Order
                </button>

            }
            else
            {
                <p>Your cart is empty.</p>
                <a href="/" class="btn btn-success">
                    Choose a Pizza
                </a>
            }
        </div>
    </div>
</div>


@code {
    private bool isSubmitting = false;
    private string? orderError;

    private async Task PlaceOrder()
    {
        if (isSubmitting || !OrderState.Order.Pizzas.Any())
            return;

        isSubmitting = true;
        orderError = null;

        try
        {
            var response = await HttpClient.PostAsJsonAsync(
                NavigationManager.BaseUri + "orders",
                OrderState.Order);

            response.EnsureSuccessStatusCode();

            var newOrderId =
                await response.Content.ReadFromJsonAsync<int>();

            OrderState.ResetOrder();
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            orderError = "Unable to save the order.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
